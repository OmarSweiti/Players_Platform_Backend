  "info": {
    "title": "Sadara API",
    "description": "Player management for sports agencies, in Arabic and English. A success is `{ data }`; a failure is an RFC 9457 problem.",
    "version": "1"
  },
  "components": {
    "headers": {
      "RequestId": {
        "description": "Names this request in logs and problem details",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds until the request may be tried again",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "CurrentSession": {
        "type": "object",
        "properties": {
          "member": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "SUPER_ADMIN",
                  "OWNER",
                  "ADMIN",
                  "SPORTING_DIRECTOR",
                  "SCOUT",
                  "COACH",
                  "ASSISTANT_COACH",
                  "GOALKEEPER_COACH",
                  "FITNESS_COACH",
                  "MEDICAL",
                  "PHYSIOTHERAPIST",
                  "LEGAL",
                  "FINANCE_MANAGER",
                  "PERFORMANCE_ANALYST",
                  "VIDEO_ANALYST",
                  "TRAINING_MANAGER",
                  "PLAYER",
                  "GUARDIAN"
                ]
              },
              "firstName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastName": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "role",
              "firstName",
              "lastName"
            ],
            "additionalProperties": false
          },
          "tenant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "locale": {
                "type": "string",
                "enum": [
                  "ar",
                  "en"
                ],
                "description": "The language members start in"
              }
            },
            "required": [
              "id",
              "slug",
              "name",
              "locale"
            ],
            "additionalProperties": false
          },
          "csrfToken": {
            "type": "string",
            "description": "Sent back in X-CSRF-Token with every write of this session"
          }
        },
        "required": [
          "member",
          "tenant",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "Live": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The problem type: urn:sadara:problem:<code>"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "This occurrence: urn:uuid:<request id>"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "INVALID_CURSOR",
              "AUTHENTICATION_REQUIRED",
              "SESSION_EXPIRED",
              "FORBIDDEN",
              "CSRF_FAILED",
              "STEP_UP_REQUIRED",
              "NOT_FOUND",
              "CONFLICT",
              "INVALID_TRANSITION",
              "IDEMPOTENCY_IN_PROGRESS",
              "IDEMPOTENCY_KEY_REUSED",
              "REVISION_MISMATCH",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "PRECONDITION_REQUIRED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "DEPENDENCY_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "description": "Safe to show, in the request's language"
          },
          "requestId": {
            "type": "string"
          },
          "fieldErrors": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "A JSON Pointer into what was sent"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "INVALID_TYPE",
                    "INVALID_FORMAT",
                    "INVALID_VALUE",
                    "TOO_SMALL",
                    "TOO_BIG",
                    "OUT_OF_RANGE",
                    "UNKNOWN_FIELD"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
