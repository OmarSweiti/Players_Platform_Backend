# The API's environment. For local work: cp .env.example .env, then set the
# two signing keys below. The API validates every variable at boot
# (src/config/env.schema.ts) and refuses to start when one is missing or
# invalid, naming it but never printing its value. The values here suit the
# local stack only (`just up` in the umbrella repository).

# development | test | staging | production — required, never inferred.
# The API description (/docs) is served in development only.
NODE_ENV=development

# The HTTP port and the route prefix (defaults: 3000 and api).
PORT=3000
API_PREFIX=api

# PostgreSQL. The local stack's password is POSTGRES_PASSWORD in ../infra/.env.
DATABASE_URL=postgresql://postgres:sadara-local-only@127.0.0.1:5432/sadara

# Token signing keys: required, at least 32 characters, different from each
# other, never committed. Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# How long an access token lasts (default: 15m).
JWT_EXPIRES_IN=15m

# Valkey, for the job queues (defaults: localhost and 6379).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The web app's origin: CORS allows it, and links in emails point to it.
CORS_ORIGIN=https://sadara.localhost

# The sender address of outgoing email.
MAIL_FROM=no-reply@sadara.localhost
