# The API's environment. For local work: cp .env.example .env. The API
# validates every variable at boot (src/config/env.schema.ts) and refuses to
# start when one is missing or invalid, naming it but never printing its
# value. The values here suit the local stack only (`just up` in the umbrella
# repository).

# development | test | staging | production — required, never inferred.
# The API description (/docs) is served in development only.
NODE_ENV=development

# The HTTP port and the route prefix (defaults: 3000 and api).
PORT=3000
API_PREFIX=api

# PostgreSQL, as the runtime role (0.4.2): data only, never the schema's owner,
# the migrator or a superuser — the API refuses to boot as one of those. Its
# local password is SADARA_APP_PASSWORD in ../infra/.env.
DATABASE_URL=postgresql://sadara_app:sadara-app-local-only@127.0.0.1:5432/sadara

# PostgreSQL, as the migrator, which acts as the schema's owner: for
# `just migrate` and the Prisma CLI only (prisma.config.ts). The API never
# reads it, and it never reaches a deployed API, worker or realtime process.
# Its local password is SADARA_MIGRATOR_PASSWORD in ../infra/.env.
MIGRATION_DATABASE_URL=postgresql://sadara_migrator:sadara-migrator-local-only@127.0.0.1:5432/sadara

# Valkey, for the job queues and the rate limits (defaults: localhost and
# 6379). While Valkey is down, rate-limited requests are refused.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The proxies whose X-Forwarded-For names the client, comma-separated:
# addresses, CIDR subnets, or loopback, linklocal and uniquelocal. Empty (the
# default): none, and the client is whoever connected — locally, every
# request through the HTTPS proxy counts as the proxy's. A deployment behind
# a load balancer names it here, or every client counts as the balancer.
TRUSTED_PROXIES=

# The web app's origin: CORS allows it, and links in emails point to it.
CORS_ORIGIN=https://sadara.localhost
# Before sign-in, the tenant is the host's (0.5.2): a tenant whose domain is
# exactly the host, else the tenant whose slug is the host's first label under
# APEX_DOMAIN — locally, sadara.localhost is the tenant with slug sadara. Every
# other host is refused as "no account here". Lower case.
APEX_DOMAIN=localhost
# The single-agency launch: hosts (comma-separated, lower case) that belong to
# the tenant DEFAULT_TENANT_SLUG. Set both or neither; unset locally.
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_HOSTS=

# The identity provider (0.5.4; ADR-0002): the issuer exactly as its tokens
# state it, HTTPS (or HTTP on this machine, the local stack's Keycloak). The API
# signs people in as OIDC_CLIENT_ID and manages their accounts as
# OIDC_ADMIN_CLIENT_ID, a service account that may manage users and nothing else.
# Locally both secrets are the umbrella's infra/.env values (development-only);
# anywhere else, the provider's real secrets, from the secret store.
OIDC_ISSUER=http://localhost:8080/realms/sadara
OIDC_CLIENT_ID=sadara-api
OIDC_CLIENT_SECRET=sadara-api-local-only
OIDC_ADMIN_CLIENT_ID=sadara-admin
OIDC_ADMIN_CLIENT_SECRET=sadara-admin-local-only
# The tenant provisioning command only (0.5.9; npm run tenant:provision): the
# service account that registers a tenant's hosts on the sign-in client. The
# API never reads these, and a deployment of the API never holds them.
OIDC_PROVISIONER_CLIENT_ID=sadara-provisioner
OIDC_PROVISIONER_CLIENT_SECRET=sadara-provisioner-local-only
# The security-event import only (0.7.3; npm run security-events:import): the
# service account that reads the realm's login and admin events and nothing
# else. The API never reads these, and a deployment of the API never holds them.
OIDC_EVENTS_CLIENT_ID=sadara-events
OIDC_EVENTS_CLIENT_SECRET=sadara-events-local-only

# The key the session's CSRF token is derived under (0.5.6): at least 32
# characters. Locally a development-only value; anywhere else, a random value
# from the secret store. To rotate it, set the new key here and the old one in
# CSRF_SECRET_PREVIOUS for 12 hours, the longest a session lives.
CSRF_SECRET=csrf-key-for-this-machine-only-never-deployed
CSRF_SECRET_PREVIOUS=

# The key a security event's client address is hashed under (0.7.3): at least
# 32 characters, apart from CSRF_SECRET. Locally a development-only value;
# anywhere else, a random value from the secret store. Rotating it starts a new
# series of hashes: an address seen before no longer matches its old events.
SECURITY_EVENT_KEY=security-event-key-for-this-machine-only-never-deployed

# Private, versioned object storage (0.8.1; ADR-0009): locally the stack's
# Versity gateway (infra/compose.yaml, service objectstore), its bucket sadara,
# and its keys, the umbrella's OBJECT_STORE_ACCESS_KEY and OBJECT_STORE_SECRET_KEY
# (infra/.env). An HTTPS endpoint anywhere else, and an access key scoped to the
# one bucket. Path-style addressing for a gateway on one host.
S3_ENDPOINT=http://127.0.0.1:7070
S3_REGION=us-east-1
S3_BUCKET=sadara
S3_ACCESS_KEY_ID=sadara-local
S3_SECRET_ACCESS_KEY=sadara-local-only
S3_FORCE_PATH_STYLE=true
# Where a browser reaches the store (0.8.3): the links the API hands out are
# signed for it. Locally the proxy's https://storage.localhost, which forwards
# to the gateway; the bucket's CORS rules admit the tenant hosts. Unset, links
# name S3_ENDPOINT, which a browser on an HTTPS page cannot use.
S3_PUBLIC_ENDPOINT=https://storage.localhost

# The worker only (0.7.6; npm run start:worker): the registry role it finds
# the active tenants with, which reads their ids and nothing else. Its password
# is the umbrella's SADARA_REGISTRY_PASSWORD (infra/.env). The API never reads
# it. The worker reads DATABASE_URL and Valkey's settings above too, and none
# of the API's identity-provider, session or mail settings.
REGISTRY_DATABASE_URL=postgresql://sadara_registry:sadara-registry-local-only@127.0.0.1:5432/sadara
# A file the worker touches after each pass of its relay, for a health check
# to read its age: the local stack's worker container sets it. Unset, none.
WORKER_HEARTBEAT_FILE=
# The worker's least severe log line: unset, NODE_ENV's (debug in development,
# every query of a pass that runs every second).
LOG_LEVEL=

# The worker's outgoing email (0.7.8): Mailpit locally — every email the stack
# sends, at http://localhost:8025. SMTP_TLS is implicit, starttls or none, and
# none only in development and test. SMTP_USERNAME and SMTP_PASSWORD, if the
# server asks for an account, together; Mailpit does not. Links in emails point
# to a tenant's own domain, else {slug}.APEX_DOMAIN (above).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender address of outgoing email.
MAIL_FROM=no-reply@sadara.localhost

# Unfinished modules, quarantined: true or false, off when unset. While off,
# every route of the module answers 404. Leave them off outside development.
FEATURE_MEDICAL=false
FEATURE_SCOUTING=false
