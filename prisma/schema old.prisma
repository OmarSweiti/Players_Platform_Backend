// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// ENUMS
//////////////////////////

enum UserRole {
  OWNER
  ADMIN
  LEGAL
  COACH
  MEDICAL
  TRAINING_MANAGER
  PLAYER
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  REJECTED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MessageType {
  TEXT
  FILE
}

//////////////////////////
// CORE
//////////////////////////

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)

  users     User[]
  players   Player[]
  trainings Training[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid())
  tenantId        String
  email           String
  passwordHash    String
  role            UserRole
  isActive        Boolean  @default(true)
  is2FAEnabled    Boolean  @default(false)

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  messages        Message[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

//////////////////////////
// PLAYER DOMAIN
//////////////////////////

model Player {
  id           String   @id @default(uuid())
  tenantId     String
  fullName     String
  dateOfBirth  DateTime?
  nationality  String?
  position     String?
  currentClub  String?
  height       Float?
  weight       Float?

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  media        PlayerMedia[]
  contracts    Contract[]
  performances PerformanceRecord[]
  ratings      Rating[]
  medicals     MedicalRecord[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
}

model PlayerMedia {
  id         String   @id @default(uuid())
  tenantId   String
  playerId   String
  fileUrl    String
  fileType   String

  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([playerId])
}

model MedicalRecord {
  id            String   @id @default(uuid())
  tenantId      String
  playerId      String
  injuryType    String
  description   String?
  recoveryDate  DateTime?
  isConfidential Boolean @default(true)

  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([playerId])
}

//////////////////////////
// CONTRACTS
//////////////////////////

model Contract {
  id         String         @id @default(uuid())
  tenantId   String
  playerId   String
  title      String
  startDate  DateTime
  endDate    DateTime
  status     ContractStatus
  fileUrl    String?

  player     Player         @relation(fields: [playerId], references: [id])

  versions   ContractVersion[]
  approvals  ContractApproval[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([playerId])
}

model ContractVersion {
  id          String   @id @default(uuid())
  contractId  String
  version     Int
  fileUrl     String

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model ContractApproval {
  id          String   @id @default(uuid())
  contractId  String
  approvedBy  String
  status      String
  comment     String?

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

//////////////////////////
// PERFORMANCE
//////////////////////////

model PerformanceRecord {
  id            String   @id @default(uuid())
  tenantId      String
  playerId      String
  matchDate     DateTime
  goals         Int      @default(0)
  assists       Int      @default(0)
  minutesPlayed Int
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)

  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Rating {
  id              String   @id @default(uuid())
  tenantId        String
  playerId        String
  technicalScore  Float
  physicalScore   Float
  mentalScore     Float
  totalScore      Float

  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([playerId])
}

//////////////////////////
// TRAINING
//////////////////////////

model Training {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  price       Float?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  enrollments Enrollment[]

  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model Enrollment {
  id            String           @id @default(uuid())
  trainingId    String
  playerId      String
  status        EnrollmentStatus
  paymentStatus PaymentStatus

  training      Training @relation(fields: [trainingId], references: [id])
  player        Player   @relation(fields: [playerId], references: [id])

  attendance    Attendance[]

  @@unique([trainingId, playerId])
}

model Attendance {
  id            String   @id @default(uuid())
  enrollmentId  String
  date          DateTime
  attended      Boolean

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

//////////////////////////
// LEGAL
//////////////////////////

model LegalTicket {
  id          String   @id @default(uuid())
  tenantId    String
  playerId    String
  createdBy   String
  subject     String
  description String
  status      String

  notes       LegalNote[]

  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model LegalNote {
  id        String   @id @default(uuid())
  ticketId  String
  note      String
  createdBy String

  ticket    LegalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////
// CHAT
//////////////////////////

model Conversation {
  id        String   @id @default(uuid())
  tenantId  String
  isGroup   Boolean  @default(false)

  messages  Message[]
  members   ConversationMember[]

  createdAt DateTime @default(now())
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  fileUrl        String?
  type           MessageType

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  createdAt      DateTime @default(now())

  @@index([conversationId])
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  content   String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////
// AUDIT LOG
//////////////////////////

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  action      String
  entityType  String
  entityId    String

  user        User @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([tenantId])
}
