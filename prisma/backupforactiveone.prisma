generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// ENUMS
//////////////////////////

enum UserRole {
  OWNER
  ADMIN
  LEGAL
  COACH
  MEDICAL
  TRAINING_MANAGER
  SCOUT
  PLAYER
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  EXPIRED
  TERMINATED
  REJECTED
}

enum ContractType {
  PROFESSIONAL
  AMATEUR
  LOAN
  SPONSORSHIP
  COACHING
  OTHER
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WAITLISTED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  WAIVED
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

enum LegalTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  RESOLVED
  CLOSED
}

enum LegalTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LW
  RW
  ST
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  LOANED_OUT
  RETIRED
  FREE_AGENT
}

enum NotificationType {
  CONTRACT_APPROVED
  CONTRACT_REJECTED
  CONTRACT_EXPIRING
  NEW_MESSAGE
  TRAINING_REMINDER
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  LEGAL_TICKET_CREATED
  LEGAL_TICKET_UPDATED
  MEDICAL_RECORD_ADDED
  SYSTEM_ALERT
}

enum DocumentEntityType {
  PLAYER
  CONTRACT
  TRAINING
  LEGAL_TICKET
  MEDICAL_RECORD
  USER
}

enum FootPreference {
  LEFT
  RIGHT
  BOTH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

//////////////////////////
// CORE
//////////////////////////

model Tenant {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  domain      String? @unique
  logoUrl     String?
  isActive    Boolean @default(true)

  /// Flexible per-tenant configuration (timezone, currency, feature flags, etc.)
  settings    Json?

  users                User[]
  players              Player[]
  seasons              Season[]
  trainings            Training[]
  trainingSessions     TrainingSession[]
  contracts            Contract[]
  tickets              LegalTicket[]
  conversations        Conversation[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  documents            Document[]
  playerMedia          PlayerMedia[]
  medicalRecords       MedicalRecord[]
  performanceRecords   PerformanceRecord[]
  ratings              Rating[]
  contractVersions     ContractVersion[]
  contractApprovals    ContractApproval[]
  enrollments          Enrollment[]
  attendance           Attendance[]
  legalNotes           LegalNote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
  @@index([isActive])
  @@index([slug])
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid

  email                 String
  passwordHash          String

  role                  UserRole

  firstName             String?
  lastName              String?
  avatarUrl             String?
  phone                 String?

  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  emailVerifiedAt       DateTime?

  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?

  isActive              Boolean   @default(true)
  is2FAEnabled          Boolean   @default(false)
  twoFASecret           String?

  /// Extra per-user preferences (UI theme, language, notification prefs, etc.)
  preferences           Json?

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages              Message[]
  conversationMembers   ConversationMember[]
  auditLogs             AuditLog[]

  createdTickets        LegalTicket[]   @relation("TicketCreator")
  assignedTickets       LegalTicket[]   @relation("TicketAssignee")
  legalNotesCreated     LegalNote[]

  contractsCreated      Contract[]
  contractVersions      ContractVersion[]
  contractApprovals     ContractApproval[]

  medicalRecordsCreated MedicalRecord[]
  ratingsCreated        Rating[]
  notifications         Notification[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@unique([tenantId, email])
  @@unique([id, tenantId])

  @@map("users")
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
}

//////////////////////////
// SEASON
//////////////////////////

/// Seasons allow grouping contracts, trainings, and performance records by period.
model Season {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid

  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contracts   Contract[]
  trainings   Training[]
  performances PerformanceRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seasons")
  @@index([tenantId])
  @@index([tenantId, isCurrent])
}

//////////////////////////
// DOCUMENT (centralized file storage)
//////////////////////////

/// Centralizes all file/document references to avoid repeating fileUrl/fileName/fileSize/mimeType across every model.
model Document {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid

  entityType  DocumentEntityType
  entityId    String             @db.Uuid

  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  description String?

  /// Uploaded by (nullable in case user is deleted)
  uploadedById String?           @db.Uuid

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("documents")
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, entityType])
}

//////////////////////////
// PLAYER DOMAIN
//////////////////////////

model Player {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid

  fullName        String
  dateOfBirth     DateTime?
  nationality     String?
  secondNationality String?
  position        PlayerPosition?
  secondaryPosition PlayerPosition?
  footPreference  FootPreference?
  status          PlayerStatus    @default(ACTIVE)
  currentClub     String?
  jerseyNumber    Int?

  height          Float?
  weight          Float?

  passportNumber  String?
  passportExpiry  DateTime?

  agentName       String?
  agentEmail      String?
  agentPhone      String?

  emergencyContact String?
  emergencyPhone   String?

  bio             String?

  /// Flexible field for custom per-tenant attributes (e.g. custom scouting tags, external IDs)
  metadata        Json?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  media           PlayerMedia[]
  contracts       Contract[]
  performances    PerformanceRecord[]
  ratings         Rating[]
  medicals        MedicalRecord[]
  enrollments     Enrollment[]
  tickets         LegalTicket[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@unique([id, tenantId])

  @@map("players")
  @@index([tenantId])
  @@index([tenantId, fullName])
  @@index([position])
  @@index([tenantId, status])
}

model PlayerMedia {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  playerId    String   @db.Uuid

  fileUrl     String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  caption     String?
  isFeatured  Boolean  @default(false)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player      Player   @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("player_media")
  @@index([tenantId])
  @@index([playerId])
}

model MedicalRecord {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  playerId        String    @db.Uuid
  createdById     String    @db.Uuid

  injuryType      String
  bodyPart        String?
  severity        String?
  description     String?
  treatment       String?
  injuryDate      DateTime?
  recoveryDate    DateTime?
  returnToPlayDate DateTime?

  isConfidential  Boolean   @default(true)

  /// Attachments (scans, reports) are stored in the Document model
  metadata        Json?

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player          Player    @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("medical_records")
  @@index([tenantId])
  @@index([tenantId, playerId])
  @@index([createdById])
}

//////////////////////////
// CONTRACTS
//////////////////////////

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  playerId        String         @db.Uuid
  createdById     String         @db.Uuid
  seasonId        String?        @db.Uuid

  title           String
  type            ContractType   @default(PROFESSIONAL)
  status          ContractStatus @default(DRAFT)

  startDate       DateTime
  endDate         DateTime

  /// Gross salary per pay period
  salaryAmount    Decimal?       @db.Decimal(14, 2)
  salaryCurrency  String?        @default("USD")
  salaryPeriod    String?        /// e.g. "MONTHLY", "WEEKLY", "ANNUAL"

  bonusDetails    Json?          /// Flexible bonus/clause structure
  signingFee      Decimal?       @db.Decimal(14, 2)

  /// Primary file stored in Document model; this field is kept for quick access to latest version
  fileUrl         String?

  signedAt        DateTime?
  approvedAt      DateTime?
  expiresNotifiedAt DateTime?

  terminationDate  DateTime?
  terminationReason String?

  /// For future extensibility (e.g. third-party IDs, federation refs)
  metadata        Json?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player          Player         @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User           @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  season          Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  versions        ContractVersion[]
  approvals       ContractApproval[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@map("contracts")
  @@index([tenantId])
  @@index([tenantId, playerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([tenantId, createdAt])
  @@index([seasonId])
}

model ContractVersion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  contractId   String   @db.Uuid
  createdById  String   @db.Uuid

  version      Int
  changeNote   String?

  fileUrl      String
  fileName     String?
  fileSize     Int?
  mimeType     String?

  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contractId, version])

  @@map("contract_versions")
  @@index([tenantId])
  @@index([contractId])
  @@index([createdById])
}

model ContractApproval {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  contractId    String         @db.Uuid
  approvedById  String         @db.Uuid

  status        ApprovalStatus @default(PENDING)
  comment       String?

  /// For ordered approval workflows (step 1 = legal, step 2 = owner, etc.)
  stepOrder     Int            @default(1)

  respondedAt   DateTime?

  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvedBy    User     @relation(fields: [approvedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([contractId, approvedById])

  @@map("contract_approvals")
  @@index([tenantId])
  @@index([contractId])
  @@index([approvedById])
}

//////////////////////////
// PERFORMANCE
//////////////////////////

model PerformanceRecord {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  playerId        String    @db.Uuid
  seasonId        String?   @db.Uuid

  matchDate       DateTime
  opponent        String?
  venue           String?
  competition     String?

  /// Starting XI or substitute
  isStarting      Boolean?

  goals           Int       @default(0)
  assists         Int       @default(0)
  minutesPlayed   Int       @default(0)
  yellowCards     Int       @default(0)
  redCards        Int       @default(0)
  shots           Int       @default(0)
  shotsOnTarget   Int       @default(0)
  passAccuracy    Decimal?  @db.Decimal(5, 2)
  rating          Decimal?  @db.Decimal(3, 1)

  /// Catch-all for position-specific or future stats (e.g. saves for GK)
  extraStats      Json?

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player          Player    @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  season          Season?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("performance_records")
  @@index([tenantId])
  @@index([tenantId, playerId])
  @@index([matchDate])
  @@index([seasonId])
}

model Rating {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  playerId        String   @db.Uuid
  createdById     String   @db.Uuid

  technicalScore  Decimal  @db.Decimal(5, 2)
  physicalScore   Decimal  @db.Decimal(5, 2)
  mentalScore     Decimal  @db.Decimal(5, 2)

  /// totalScore is derived from the three scores; kept for query performance.
  /// Application layer must ensure: totalScore = (technical + physical + mental) / 3
  totalScore      Decimal  @db.Decimal(5, 2)

  notes           String?

  /// Extra scoring dimensions (e.g. tactical, leadership) for future flexibility
  extraScores     Json?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player          Player   @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ratings")
  @@index([tenantId])
  @@index([tenantId, playerId])
  @@index([createdById])
}

//////////////////////////
// TRAINING
//////////////////////////

model Training {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  seasonId     String?  @db.Uuid

  title        String
  description  String?

  startDate    DateTime
  endDate      DateTime

  location     String?
  capacity     Int?

  price        Decimal? @db.Decimal(10, 2)
  currency     String?  @default("USD")

  isRecurring  Boolean  @default(false)

  /// Flexible: store recurrence rules, target positions, etc.
  metadata     Json?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  season       Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  sessions     TrainingSession[]
  enrollments  Enrollment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("trainings")
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([seasonId])
}

/// Individual sessions within a training program (supports recurring / multi-session trainings)
model TrainingSession {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  trainingId   String   @db.Uuid

  title        String?
  date         DateTime
  startTime    DateTime?
  endTime      DateTime?
  location     String?

  isCancelled  Boolean  @default(false)
  cancelNote   String?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  training     Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  attendance   Attendance[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("training_sessions")
  @@index([tenantId])
  @@index([trainingId])
  @@index([date])
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  trainingId      String           @db.Uuid
  playerId        String           @db.Uuid

  status          EnrollmentStatus @default(PENDING)
  paymentStatus   PaymentStatus    @default(UNPAID)

  rejectionReason String?
  notes           String?

  paidAt          DateTime?
  paidAmount      Decimal?         @db.Decimal(10, 2)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  training        Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player          Player           @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  attendance      Attendance[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([trainingId, playerId])

  @@map("enrollments")
  @@index([tenantId])
  @@index([trainingId])
  @@index([playerId])
}

model Attendance {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  enrollmentId      String          @db.Uuid
  trainingSessionId String?         @db.Uuid

  date              DateTime
  status            AttendanceStatus @default(ABSENT)
  note              String?

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment        Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([enrollmentId, date])

  @@map("attendance")
  @@index([tenantId])
  @@index([date])
  @@index([trainingSessionId])
}

//////////////////////////
// LEGAL
//////////////////////////

model LegalTicket {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  playerId      String              @db.Uuid
  createdById   String              @db.Uuid
  assignedToId  String?             @db.Uuid

  subject       String
  description   String

  status        LegalTicketStatus   @default(OPEN)
  priority      LegalTicketPriority @default(MEDIUM)

  resolvedAt    DateTime?
  closedAt      DateTime?
  dueDate       DateTime?

  /// For linking to external legal case IDs, contract refs, etc.
  metadata      Json?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy     User     @relation("TicketCreator", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedTo    User?    @relation("TicketAssignee", fields: [assignedToId, tenantId], references: [id, tenantId], onDelete: SetNull)

  notes         LegalNote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("legal_tickets")
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([tenantId, createdAt])
  @@index([assignedToId])
}

model LegalNote {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  ticketId      String      @db.Uuid
  createdById   String      @db.Uuid

  note          String
  isInternal    Boolean     @default(false)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        LegalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy     User        @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("legal_notes")
  @@index([tenantId])
  @@index([ticketId])
  @@index([createdById])
}

//////////////////////////
// CHAT
//////////////////////////

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid

  isGroup        Boolean  @default(false)
  name           String?
  imageUrl       String?
  description    String?

  lastMessageAt  DateTime?

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages       Message[]
  members        ConversationMember[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@map("conversations")
  @@index([tenantId])
  @@index([tenantId, lastMessageAt])
}

model ConversationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  conversationId String                 @db.Uuid
  userId         String                 @db.Uuid

  role           ConversationMemberRole @default(MEMBER)

  /// For unread message count / read receipts
  lastReadAt     DateTime?

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])

  @@map("conversation_members")
  @@index([tenantId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  conversationId String      @db.Uuid

  /// Nullable: sender may be deleted or a system message
  senderId       String?     @db.Uuid

  content        String?

  /// File details kept on Message for quick rendering; full doc stored in Document model
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?

  type           MessageType

  isEdited       Boolean     @default(false)
  editedAt       DateTime?

  /// Soft delete (message recalled)
  deletedAt      DateTime?

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Sender is looked up by (senderId, tenantId) only when senderId is not null
  sender         User?        @relation(fields: [senderId, tenantId], references: [id, tenantId], onDelete: SetNull)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("messages")
  @@index([tenantId])
  @@index([tenantId, conversationId])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  userId          String           @db.Uuid

  type            NotificationType
  title           String?
  content         String

  /// Deep-link target: the entity this notification is about
  referenceType   String?
  referenceId     String?          @db.Uuid

  isRead          Boolean          @default(false)
  readAt          DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("notifications")
  @@index([tenantId])
  @@index([tenantId, userId, isRead])
  @@index([referenceType, referenceId])
}

//////////////////////////
// AUDIT LOG
//////////////////////////

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid

  /// Nullable separately — not in a composite FK to avoid Prisma limitation with nullable composite keys
  userId      String?  @db.Uuid

  action      String
  entityType  String
  entityId    String

  oldValues   Json?
  newValues   Json?

  ipAddress   String?
  userAgent   String?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// AuditLog intentionally does NOT use composite FK for user due to Prisma's
  /// limitation with nullable fields in composite foreign keys. userId is stored
  /// as a plain reference; join to User in application layer if needed.
  user        User?    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@map("audit_logs")
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([userId])
}
