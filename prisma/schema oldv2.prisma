// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// ENUMS
//////////////////////////

enum UserRole {
  OWNER
  ADMIN
  LEGAL
  COACH
  MEDICAL
  TRAINING_MANAGER
  PLAYER
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  REJECTED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MessageType {
  TEXT
  FILE
}

enum LegalTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////////
// CORE
//////////////////////////

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)

  users     User[]
  players   Player[]
  trainings Training[]
  contracts Contract[]
  tickets   LegalTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  email           String
  passwordHash    String
  role            UserRole
  isActive        Boolean  @default(true)
  is2FAEnabled    Boolean  @default(false)

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages        Message[]
  auditLogs       AuditLog[]
  createdTickets  LegalTicket[] @relation("TicketCreator")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])

  contractsCreated Contract[] @relation("ContractCreator")
  medicalRecordsCreated MedicalRecord[] @relation("MedicalRecordCreator")
  ratingsCreated Rating[] @relation("RatingCreator")
  approvalsMade ContractApproval[] @relation("ContractApprover")
  contractVersionsCreated ContractVersion[] @relation("ContractVersionCreator")
  legalNotesCreated LegalNote[] @relation("LegalNoteCreator")
}

//////////////////////////
// PLAYER DOMAIN
//////////////////////////

model Player {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  fullName     String
  dateOfBirth  DateTime?
  nationality  String?
  position     String?
  currentClub  String?
  height       Float?
  weight       Float?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  media        PlayerMedia[]
  contracts    Contract[]
  performances PerformanceRecord[]
  ratings      Rating[]
  medicals     MedicalRecord[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
}

model PlayerMedia {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  playerId   String   @db.Uuid
  fileUrl    String
  fileType   String

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playerId])
}

model MedicalRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  playerId      String   @db.Uuid
  createdById   String   @db.Uuid
  injuryType    String
  description   String?
  recoveryDate  DateTime?
  isConfidential Boolean @default(true)

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy User @relation("MedicalRecordCreator", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, playerId])
  
}

//////////////////////////
// CONTRACTS
//////////////////////////

model Contract {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  playerId   String         @db.Uuid
  createdById String        @db.Uuid
  title      String
  startDate  DateTime
  endDate    DateTime
  status     ContractStatus
  fileUrl    String?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player     Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdBy   User @relation("ContractCreator", fields: [createdById], references: [id])

  versions   ContractVersion[]
  approvals  ContractApproval[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, playerId])
  

}

model ContractVersion {
  tenantId String @db.Uuid
  id          String   @id @default(uuid()) @db.Uuid
  contractId  String   @db.Uuid
  createdById String   @db.Uuid
  version     Int
  fileUrl     String

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User @relation("ContractVersionCreator", fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contractId, version])

  

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ContractApproval {
  tenantId String @db.Uuid
  id          String         @id @default(uuid()) @db.Uuid
  contractId  String         @db.Uuid
  approvedById String        @db.Uuid
  status      ApprovalStatus
  comment     String?

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approvedBy User @relation("ContractApprover", fields: [approvedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

//////////////////////////
// PERFORMANCE
//////////////////////////

model PerformanceRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  playerId      String   @db.Uuid
  matchDate     DateTime
  goals         Int      @default(0)
  assists       Int      @default(0)
  minutesPlayed Int
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, playerId])
}

model Rating {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  playerId        String   @db.Uuid
  createdById     String   @db.Uuid
  technicalScore  Float
  physicalScore   Float
  mentalScore     Float
  totalScore      Float

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, playerId])
  
  createdBy User @relation("RatingCreator", fields: [createdById], references: [id])
  
}

//////////////////////////
// TRAINING
//////////////////////////

model Training {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  price Decimal? @db.Decimal(10,2)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  trainingId    String           @db.Uuid
  playerId      String           @db.Uuid
  status        EnrollmentStatus
  paymentStatus PaymentStatus

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  training      Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  attendance    Attendance[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([trainingId, playerId])
}

model Attendance {
  id            String   @id @default(uuid()) @db.Uuid
  enrollmentId  String   @db.Uuid
  date          DateTime
  attended      Boolean

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([enrollmentId, date])
}

//////////////////////////
// LEGAL
//////////////////////////

model LegalTicket {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  playerId    String            @db.Uuid
  createdById String            @db.Uuid
  subject     String
  description String
  status      LegalTicketStatus

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  player      Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("TicketCreator", fields: [createdById], references: [id])

  notes       LegalNote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model LegalNote {
  tenantId String @db.Uuid
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  createdById String   @db.Uuid
  note        String

  ticket      LegalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("LegalNoteCreator", fields: [createdById], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

//////////////////////////
// CHAT
//////////////////////////

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  isGroup   Boolean  @default(false)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages  Message[]
  members   ConversationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationMember {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  userId         String @db.Uuid

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  tenantId String @db.Uuid
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  content        String?
  fileUrl        String?
  type           MessageType

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt


  

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  type      String
  content   String
  isRead    Boolean  @default(false)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

//////////////////////////
// AUDIT LOG
//////////////////////////

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  action      String
  entityType  String
  entityId    String

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([tenantId])
}
