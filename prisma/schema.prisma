generator client {
  provider = "prisma-client-js"
  // Output to default location so @prisma/client package works correctly
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Every name in the database is lower snake_case (0.4.0): a camelCase field
// carries @map("snake_case") and every enum @@map, so no SQL statement has to
// quote a name. test/db/naming.integration-spec.ts refuses anything else.

// Every foreign key to a tenant-owned row is composite, (…Id, tenantId), so it
// cannot name another tenant's row; where a row has two parents that must
// agree, the key carries the shared column too (attendance, treatment
// sessions). No key deletes into tenantId (SET NULL) or cascades a key change:
// every relation is onUpdate: Restrict (0.4.4).
// test/db/foreign-keys.integration-spec.ts holds the catalog to this.

// Every model is classified tenant-owned or global in
// src/infrastructure/prisma/model-classification.ts (0.4.5). A tenant-owned
// table has ENABLE and FORCE ROW LEVEL SECURITY, the runtime role's tenant
// policy on app.tenant_id, the owner's read-only policy, and a trigger that
// refuses any change of tenant_id; tenants is held the same way by its id and
// read before sign-in through the tenant_directory view. Reference data is
// read-only to the runtime role. Prisma's drift check sees none of this:
// scripts/generate-rls.ts writes it for a new table, and
// test/db/rls.integration-spec.ts holds the catalog to it.

// Every index on a tenant-owned table leads with tenantId, so it narrows to one
// tenant before anything else (0.4.6); only the row's own id may lead instead,
// and a few uniqueness rules over a parent's id (allowlisted with their
// reasons). An index serves every foreign key, and no plain index repeats the
// leading columns of another. test/db/indexes.integration-spec.ts holds the
// catalog to this.

//////////////////////////
// ENUMS
//////////////////////////

/// The two languages Sadara ships in (ADR-0008).
enum Locale {
  ar
  en

  @@map("locale")
}

enum UserRole {
  SUPER_ADMIN        // Platform-level admin (multi-tenant SaaS)
  OWNER              // Club/academy owner
  ADMIN              // Operational administrator
  SPORTING_DIRECTOR  // Oversees squad planning, transfers, recruitment
  SCOUT              // Talent discovery and reporting
  COACH              // Head coach
  ASSISTANT_COACH    // Assistant coaching staff
  GOALKEEPER_COACH   // Specialized GK coach
  FITNESS_COACH      // Physical conditioning
  MEDICAL            // Medical staff
  PHYSIOTHERAPIST    // Rehabilitation specialist
  LEGAL              // Legal department
  FINANCE_MANAGER    // Salary, payroll, transfers
  PERFORMANCE_ANALYST // Match/stats analysis
  VIDEO_ANALYST      // Video tagging and review
  TRAINING_MANAGER   // Training coordination
  PLAYER             // Athlete
  GUARDIAN           // Parent/guardian (academy)

  @@map("user_role")
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  EXPIRED
  TERMINATED
  REJECTED

  @@map("contract_status")
}

enum ContractType {
  PROFESSIONAL
  AMATEUR
  LOAN
  SPONSORSHIP
  COACHING
  OTHER

  @@map("contract_type")
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WAITLISTED

  @@map("enrollment_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  WAIVED

  @@map("payment_status")
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM

  @@map("message_type")
}

enum ConversationMemberRole {
  MEMBER
  ADMIN

  @@map("conversation_member_role")
}

enum LegalTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  RESOLVED
  CLOSED

  @@map("legal_ticket_status")
}

enum LegalTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("legal_ticket_priority")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LW
  RW
  ST

  @@map("player_position")
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  LOANED_OUT
  RETIRED
  FREE_AGENT

  @@map("player_status")
}

enum NotificationType {
  CONTRACT_APPROVED
  CONTRACT_REJECTED
  CONTRACT_EXPIRING
  NEW_MESSAGE
  TRAINING_REMINDER
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  LEGAL_TICKET_CREATED
  LEGAL_TICKET_UPDATED
  MEDICAL_RECORD_ADDED
  SYSTEM_ALERT

  @@map("notification_type")
}

enum DocumentEntityType {
  PLAYER
  CONTRACT
  TRAINING
  LEGAL_TICKET
  MEDICAL_RECORD
  USER
  MESSAGE
  CONTRACT_VERSION
  TRAINING_SESSION
  ENROLLMENT
  LEGAL_NOTE
  PLAYER_MEDIA
  SEASON
  PERFORMANCE_RECORD
  RATING

  @@map("document_entity_type")
}

enum FootPreference {
  LEFT
  RIGHT
  BOTH

  @@map("foot_preference")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED

  @@map("attendance_status")
}

enum SalaryPeriod {
  WEEKLY
  MONTHLY
  ANNUAL

  @@map("salary_period")
}

//////////////////////////
// PERMISSION SYSTEM
//////////////////////////

enum PermissionCategory {
  PLAYER
  CONTRACT
  TRAINING
  MEDICAL
  SCOUTING
  MATCH
  FINANCE
  LEGAL
  CHAT
  USER
  TENANT
  REPORT
  DOCUMENT
  NOTIFICATION

  @@map("permission_category")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  EXPORT
  IMPORT
  ASSIGN
  VIEW_CONFIDENTIAL
  MANAGE

  @@map("permission_action")
}

//////////////////////////
// SCOUTING
//////////////////////////

enum ScoutReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("scout_report_status")
}

enum RecommendationLevel {
  STRONG_SIGN
  SIGN
  MONITOR
  NOT_SUITABLE

  @@map("recommendation_level")
}

// Medical Module Enums
enum InjuryType {
  MUSCLE
  LIGAMENT
  TENDON
  BONE
  JOINT
  HEAD_CONCUSSION
  OTHER

  @@map("injury_type")
}

enum InjurySeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL

  @@map("injury_severity")
}

enum TreatmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("treatment_status")
}

enum MedicalRecordType {
  INJURY
  ILLNESS
  TREATMENT
  VACCINATION
  MEDICAL_EXAM
  REHABILITATION

  @@map("medical_record_type")
}

//////////////////////////
// CORE
//////////////////////////

model Tenant {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(100)
  domain      String? @unique @db.VarChar(255)
  logoUrl     String? @db.VarChar(500) @map("logo_url")
  isActive    Boolean @default(true) @map("is_active")

  /// Typed settings, out of the settings JSON (0.4.8): the IANA zone dates and
  /// times are shown in (a trigger, hand-written SQL, refuses any other value),
  /// the language a member starts in, and the currency amounts default to.
  timezone        String             @default("UTC")
  defaultLocale   Locale             @default(ar) @map("default_locale")
  defaultCurrency String             @default("JOD") @db.Char(3) @map("default_currency")
  defaultCurrencyDefinition CurrencyDefinition @relation(fields: [defaultCurrency], references: [code], onDelete: Restrict, onUpdate: Restrict)

  /// Untyped per-tenant configuration. The time zone, locale and currency live
  /// in their own columns; a CHECK (hand-written SQL) keeps them out of here.
  settings    Json?

  users                User[]
  players              Player[]
  seasons              Season[]
  trainings            Training[]
  trainingSessions     TrainingSession[]
  contracts            Contract[]
  tickets              LegalTicket[]
  conversations        Conversation[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  documents            Document[]
  playerMedia          PlayerMedia[]
  medicalRecords       MedicalRecord[]
  performanceRecords   PerformanceRecord[]
  ratings              Rating[]
  contractVersions     ContractVersion[]
  contractApprovals    ContractApproval[]
  enrollments          Enrollment[]
  attendance           Attendance[]
  legalNotes           LegalNote[]
  scoutingReports     ScoutingReport[]
  playerWatchlists    PlayerWatchlist[]
  scoutingAssignments ScoutingAssignment[]
  treatmentSessions   TreatmentSession[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenants")
  @@index([isActive])
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid @map("tenant_id")

  email                 String    @db.VarChar(255)
  /// The address as it is unique within the tenant, for the life of the
  /// membership: an archived member keeps it, and comes back through
  /// reactivation, never as a second account (0.4.9). NFKC, trimmed, lower
  /// case (src/modules/users/domain/email.ts); a CHECK (hand-written SQL)
  /// holds it equal to that form of email.
  normalizedEmail       String    @db.VarChar(255) @map("normalized_email")
  // No credential is stored here: passwords, second factors, reset and
  // verification tokens and lockouts belong to the identity provider
  // (ADR-0002); the local credential columns were dropped in 0.1.6.

  role                  UserRole

  firstName             String?   @db.VarChar(100) @map("first_name")
  lastName              String?   @db.VarChar(100) @map("last_name")
  avatarUrl             String?   @db.VarChar(500) @map("avatar_url")
  phone                 String?   @db.VarChar(20)

  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(3)

  isActive              Boolean   @default(true) @map("is_active")

  /// Extra per-user preferences (UI theme, language, notification prefs, etc.)
  preferences           Json?

  /// Staff profile enhancements
  department            String?   @db.VarChar(100) // e.g., "Coaching", "Medical", "Legal"
  position              String?   @db.VarChar(150) // Job title
  certifications        Json?     // Array of certifications/licenses
  employmentStartDate   DateTime? @map("employment_start_date") @db.Date
  employmentEndDate     DateTime? @map("employment_end_date") @db.Date
  bio                   String?   @db.Text
  emergencyContact      String?   @db.VarChar(150) @map("emergency_contact")
  emergencyPhone        String?   @db.VarChar(20) @map("emergency_phone")

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  messages              Message[]
  conversationMembers   ConversationMember[]
  auditLogs             AuditLog[]

  createdTickets        LegalTicket[]   @relation("TicketCreator")
  assignedTickets       LegalTicket[]   @relation("TicketAssignee")
  legalNotesCreated     LegalNote[]

  contractsCreated      Contract[]
  contractVersions      ContractVersion[]
  contractApprovals     ContractApproval[]

  medicalRecordsCreated MedicalRecord[]
  ratingsCreated        Rating[]
  notifications         Notification[]

  scoutingReports       ScoutingReport[]
  playerWatchlists      PlayerWatchlist[]
  scoutingAssignmentsTo ScoutingAssignment[] @relation("ScoutingAssignmentTo")
  scoutingAssignmentsBy ScoutingAssignment[] @relation("ScoutingAssignmentBy")
  treatmentSessions     TreatmentSession[]   @relation("TreatmentSessionConductor")
  uploadedDocuments     Document[]

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, normalizedEmail])
  @@unique([id, tenantId])

  @@map("users")
  @@index([tenantId, isActive])
  @@index([tenantId, role])
}

//////////////////////////
// SEASON
//////////////////////////

model Season {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")

  name        String   @db.VarChar(255)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isCurrent   Boolean  @default(false) @map("is_current")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  contracts   Contract[]
  trainings   Training[]
  performances PerformanceRecord[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("seasons")
  @@index([tenantId, isCurrent])
}

//////////////////////////
// DOCUMENT (centralized file storage)
//////////////////////////

model Document {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid @map("tenant_id")

  entityType  DocumentEntityType @map("entity_type")
  entityId    String             @db.Uuid @map("entity_id")

  fileUrl     String             @db.VarChar(500) @map("file_url")
  fileName    String             @db.VarChar(255) @map("file_name")
  fileSize    Int? @map("file_size")
  mimeType    String?            @db.VarChar(100) @map("mime_type")
  description String?            @db.VarChar(500)

  /// The member who uploaded it: one of the document's own tenant (0.4.4)
  uploadedById String?           @db.Uuid @map("uploaded_by_id")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy  User?              @relation(fields: [uploadedById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("documents")
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, uploadedById])
}

//////////////////////////
// PLAYER DOMAIN
//////////////////////////

model Player {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid @map("tenant_id")

  fullName          String          @db.VarChar(255) @map("full_name")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  nationality       String?         @db.VarChar(100)
  secondNationality String?         @db.VarChar(100) @map("second_nationality")
  position          PlayerPosition?
  secondaryPosition PlayerPosition? @map("secondary_position")
  footPreference    FootPreference? @map("foot_preference")
  status            PlayerStatus    @default(ACTIVE)
  currentClub       String?         @db.VarChar(150) @map("current_club")
  jerseyNumber      Int? @map("jersey_number")

  height            Float?
  weight            Float?

  passportNumber    String?         @db.VarChar(20) @map("passport_number")
  passportExpiry    DateTime? @map("passport_expiry") @db.Date

  agentName         String?         @db.VarChar(150) @map("agent_name")
  agentEmail        String?         @db.VarChar(255) @map("agent_email")
  agentPhone        String?         @db.VarChar(20) @map("agent_phone")

  emergencyContact  String?         @db.VarChar(150) @map("emergency_contact")
  emergencyPhone    String?         @db.VarChar(20) @map("emergency_phone")

  bio               String?         @db.Text

  metadata          Json?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  media             PlayerMedia[]
  contracts         Contract[]
  performances      PerformanceRecord[]
  ratings           Rating[]
  medicals          MedicalRecord[]
  enrollments       Enrollment[]
  tickets           LegalTicket[]
  scoutingReports    ScoutingReport[]
  watchlists         PlayerWatchlist[]
  treatmentSessions  TreatmentSession[]

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("players")
  @@index([tenantId, fullName])
  @@index([tenantId, position])
  @@index([tenantId, status])
}

model PlayerMedia {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  playerId    String   @db.Uuid @map("player_id")

  fileUrl     String   @db.VarChar(500) @map("file_url")
  fileName    String?  @db.VarChar(255) @map("file_name")
  fileSize    Int? @map("file_size")
  mimeType    String?  @db.VarChar(100) @map("mime_type")
  caption     String?  @db.VarChar(255)
  isFeatured  Boolean  @default(false) @map("is_featured")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  player      Player   @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("player_media")
  @@index([tenantId, playerId])
}

model MedicalRecord {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid @map("tenant_id")
  playerId         String    @db.Uuid @map("player_id")
  createdById      String    @db.Uuid @map("created_by_id")

  injuryType       String    @db.VarChar(255) @map("injury_type")
  bodyPart         String?   @db.VarChar(100) @map("body_part")
  severity         String?   @db.VarChar(50)
  description      String?   @db.Text
  treatment        String?   @db.Text
  injuryDate       DateTime? @map("injury_date") @db.Date
  recoveryDate     DateTime? @map("recovery_date") @db.Date
  returnToPlayDate DateTime? @map("return_to_play_date") @db.Date

  isConfidential   Boolean   @default(true) @map("is_confidential")

  /// Attachments (scans, reports) are stored in the Document model
  metadata         Json?

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  player           Player    @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createdBy        User      @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  treatmentSessions TreatmentSession[]

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])
  /// The parent key of a treatment session's record: the same player's (0.4.4)
  @@unique([id, tenantId, playerId])

  @@map("medical_records")
  @@index([tenantId, createdById])
  @@index([tenantId, playerId])
}

//////////////////////////
// CONTRACTS
//////////////////////////

model Contract {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid @map("tenant_id")
  playerId          String         @db.Uuid @map("player_id")
  createdById       String         @db.Uuid @map("created_by_id")
  seasonId          String?        @db.Uuid @map("season_id")

  title             String         @db.VarChar(255)
  type              ContractType   @default(PROFESSIONAL)
  status            ContractStatus @default(DRAFT)

  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date

  /// Gross salary per pay period, exact: NUMERIC(19,4) holds every currency's
  /// decimals, and code handles it as a Money (src/common/money; 0.4.7).
  salaryAmount      Decimal?       @db.Decimal(19, 4) @map("salary_amount")
  /// An ISO 4217 code of currency_definitions; JOD, the tenant's default (OPEN-09).
  salaryCurrency    String         @default("JOD") @db.Char(3) @map("salary_currency")
  salaryPeriod      SalaryPeriod? @map("salary_period")

  bonusDetails      Json? @map("bonus_details")
  signingFee        Decimal?       @db.Decimal(19, 4) @map("signing_fee")

  /// Primary file stored in Document model; this field is kept for quick access to latest version
  fileUrl           String?        @db.VarChar(500) @map("file_url")

  signedAt          DateTime? @map("signed_at") @db.Timestamptz(3)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(3)
  expiresNotifiedAt DateTime? @map("expires_notified_at") @db.Timestamptz(3)

  terminationDate   DateTime? @map("termination_date") @db.Date
  terminationReason String?        @db.VarChar(500) @map("termination_reason")

  metadata          Json?

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  player            Player         @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createdBy         User           @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  season            Season?        @relation(fields: [seasonId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  salaryCurrencyDefinition CurrencyDefinition @relation(fields: [salaryCurrency], references: [code], onDelete: Restrict, onUpdate: Restrict)

  versions          ContractVersion[]
  approvals         ContractApproval[]

  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("contracts")
  @@index([tenantId, createdAt])
  @@index([tenantId, createdById])
  @@index([tenantId, endDate])
  @@index([tenantId, playerId, status])
  @@index([tenantId, seasonId])
  @@index([tenantId, startDate])
  @@index([tenantId, status, createdAt])
}

model ContractVersion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  contractId   String   @db.Uuid @map("contract_id")
  createdById  String   @db.Uuid @map("created_by_id")

  version      Int
  changeNote   String?  @db.VarChar(500) @map("change_note")

  fileUrl      String   @db.VarChar(500) @map("file_url")
  fileName     String?  @db.VarChar(255) @map("file_name")
  fileSize     Int? @map("file_size")
  mimeType     String?  @db.VarChar(100) @map("mime_type")

  contract     Contract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User     @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([contractId, version])
  @@unique([id, tenantId])

  @@map("contract_versions")
  @@index([tenantId, createdById])
}

model ContractApproval {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid @map("tenant_id")
  contractId    String         @db.Uuid @map("contract_id")
  approvedById  String         @db.Uuid @map("approved_by_id")

  status        ApprovalStatus @default(PENDING)
  comment       String?        @db.VarChar(1000)

  /// For ordered approval workflows (step 1 = legal, step 2 = owner, etc.)
  stepOrder     Int            @default(1) @map("step_order")

  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(3)

  contract      Contract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvedBy    User     @relation(fields: [approvedById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([contractId, approvedById])
  @@unique([id, tenantId])

  @@map("contract_approvals")
  @@index([tenantId, approvedById])
}

