  @@index([tenantId, status])
}

//////////////////////////
// PERMISSION SYSTEM
//////////////////////////

/// Every ISO 4217 code an amount may carry, with its official decimals (0.4.7;
/// ADR-0006). src/common/money/iso-4217.ts is the list and the money migration
/// seeds it; the runtime role only reads it. CHECKs (hand-written SQL): a code
/// is three capital letters, an exponent is 0 to 4.
model CurrencyDefinition {
  code              String       @id @db.Char(3)
  minorUnitExponent Int          @db.SmallInt @map("minor_unit_exponent")
  enabled           Boolean      @default(true)

  contracts         Contract[]
  trainings         Training[]
  enrollments       Enrollment[]
  tenants           Tenant[]

  @@map("currency_definitions")
}

model Permission {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique @db.VarChar(100) // e.g., "player.create"
  category    PermissionCategory
  action      PermissionAction
  description String?           @db.VarChar(255)
  
  roles       RolePermission[]
  
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  
  @@map("permissions")
  @@index([action])
  @@index([category])
}

model RolePermission {
  id             String     @id @default(uuid()) @db.Uuid
  roleId         UserRole @map("role_id")
  permissionId   String     @db.Uuid @map("permission_id")
  
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@index([permissionId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid @map("tenant_id")
  conversationId String      @db.Uuid @map("conversation_id")

  /// Nullable: sender may be deleted or a system message
  senderId       String?     @db.Uuid @map("sender_id")

  content        String?     @db.Text

  /// File details kept on Message for quick rendering; full doc stored in Document model
  fileUrl        String?     @db.VarChar(500) @map("file_url")
  fileName       String?     @db.VarChar(255) @map("file_name")
  fileSize       Int? @map("file_size")
  mimeType       String?     @db.VarChar(100) @map("mime_type")

  type           MessageType

  isEdited       Boolean     @default(false) @map("is_edited")
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)

  /// Soft delete (message recalled)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation   Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  sender         User?        @relation(fields: [senderId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("messages")
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, senderId])
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid @map("tenant_id")
  userId          String           @db.Uuid @map("user_id")

  type            NotificationType
  title           String?          @db.VarChar(255)
  content         String           @db.Text

  /// Deep-link target: the entity this notification is about
  referenceType   String?          @db.VarChar(100) @map("reference_type")
  referenceId     String?          @db.Uuid @map("reference_id")

  isRead          Boolean          @default(false) @map("is_read")
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User             @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("notifications")
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, userId, isRead])
}

//////////////////////////
// AUDIT LOG
//////////////////////////

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")

  userId      String?  @db.Uuid @map("user_id")

  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100) @map("entity_type")
  entityId    String   @db.Uuid @map("entity_id")

  oldValues   Json? @map("old_values")
  newValues   Json? @map("new_values")

  ipAddress   String?  @db.VarChar(45) @map("ip_address")
  userAgent   String?  @db.VarChar(500) @map("user_agent")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user        User?    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("audit_logs")
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
}