model ScoutingReport {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid @map("tenant_id")
  scoutId         String             @db.Uuid @map("scout_id")
  playerId        String?            @db.Uuid @map("player_id")  // Null for external prospects
  
  // Player being scouted (if not in system yet)
  prospectName    String?            @db.VarChar(255) @map("prospect_name")
  prospectAge     Int? @map("prospect_age")
  prospectClub    String?            @db.VarChar(255) @map("prospect_club")
  prospectPosition PlayerPosition? @map("prospect_position")
  prospectNationality String?        @db.VarChar(100) @map("prospect_nationality")
  
  status          ScoutReportStatus  @default(DRAFT)
  recommendation  RecommendationLevel?
  
  // Evaluation scores (1-10)
  technicalScore  Decimal?           @db.Decimal(3, 1) @map("technical_score")
  physicalScore   Decimal?           @db.Decimal(3, 1) @map("physical_score")
  tacticalScore   Decimal?           @db.Decimal(3, 1) @map("tactical_score")
  mentalScore     Decimal?           @db.Decimal(3, 1) @map("mental_score")
  
  strengths       String?            @db.Text
  weaknesses      String?            @db.Text
  personalityNotes String?           @db.Text @map("personality_notes")
  tacticalFit     String?            @db.Text @map("tactical_fit")
  
  overallRating   Decimal?           @db.Decimal(3, 1) @map("overall_rating")
  potentialRating Decimal?           @db.Decimal(3, 1) @map("potential_rating")
  
  reportDate      DateTime @map("report_date") @db.Date
  matchObserved   String?            @db.VarChar(255) @map("match_observed")
  
  metadata        Json?
  
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scout           User               @relation(fields: [scoutId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  player          Player?            @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  
  @@unique([id, tenantId])
  @@map("scouting_reports")
  @@index([tenantId, playerId])
  @@index([tenantId, recommendation])
  @@index([tenantId, scoutId])
  @@index([tenantId, status])
}

model PlayerWatchlist {
