//////////////////////////

model PerformanceRecord {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid @map("tenant_id")
  playerId        String    @db.Uuid @map("player_id")
  seasonId        String?   @db.Uuid @map("season_id")

  matchDate       DateTime @map("match_date") @db.Date
  opponent        String?   @db.VarChar(150)
  venue           String?   @db.VarChar(200)
  competition     String?   @db.VarChar(200)

  /// Starting XI or substitute
  isStarting      Boolean? @map("is_starting")

  goals           Int       @default(0)
  assists         Int       @default(0)
  minutesPlayed   Int       @default(0) @map("minutes_played")
  yellowCards     Int       @default(0) @map("yellow_cards")
  redCards        Int       @default(0) @map("red_cards")
  shots           Int       @default(0)
  shotsOnTarget   Int       @default(0) @map("shots_on_target")
  passAccuracy    Decimal?  @db.Decimal(5, 2) @map("pass_accuracy")
  rating          Decimal?  @db.Decimal(3, 1)

  /// Catch-all for position-specific or future stats (e.g. saves for GK)
  extraStats      Json? @map("extra_stats")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  player          Player    @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  season          Season?   @relation(fields: [seasonId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("performance_records")
  @@index([tenantId, matchDate])
  @@index([tenantId, playerId, matchDate])
  @@index([tenantId, seasonId])
}

model Rating {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid @map("tenant_id")
  playerId        String   @db.Uuid @map("player_id")
  createdById     String   @db.Uuid @map("created_by_id")

  technicalScore  Decimal  @db.Decimal(5, 2) @map("technical_score")
  physicalScore   Decimal  @db.Decimal(5, 2) @map("physical_score")
  mentalScore     Decimal  @db.Decimal(5, 2) @map("mental_score")

  /// totalScore is derived from the three scores; kept for query performance.
  /// Application layer must ensure: totalScore = (technical + physical + mental) / 3
  totalScore      Decimal  @db.Decimal(5, 2) @map("total_score")

  notes           String?  @db.Text

  /// Extra scoring dimensions (e.g. tactical, leadership) for future flexibility
  extraScores     Json? @map("extra_scores")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  player          Player   @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User     @relation(fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("ratings")
  @@index([tenantId, createdById])
  @@index([tenantId, playerId])
}

//////////////////////////
// TRAINING
//////////////////////////

model Training {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  seasonId     String?  @db.Uuid @map("season_id")

  title        String   @db.VarChar(255)
  description  String?  @db.Text

  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date

  location     String?  @db.VarChar(255)
  capacity     Int?

  price        Decimal? @db.Decimal(19, 4)
  /// An ISO 4217 code of currency_definitions; JOD, the tenant's default (OPEN-09).
  currency     String   @default("JOD") @db.Char(3)

  isRecurring  Boolean  @default(false) @map("is_recurring")

  /// Flexible: store recurrence rules, target positions, etc.
  metadata     Json?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season       Season?  @relation(fields: [seasonId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  currencyDefinition CurrencyDefinition @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Restrict)

  sessions     TrainingSession[]
  enrollments  Enrollment[]

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])

  @@map("trainings")
  @@index([tenantId, createdAt])
  @@index([tenantId, isRecurring])
  @@index([tenantId, seasonId])
  @@index([tenantId, startDate, endDate])
}

/// Individual sessions within a training program (supports recurring / multi-session trainings)
model TrainingSession {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  trainingId   String   @db.Uuid @map("training_id")

  title        String?  @db.VarChar(255)
  /// The session's day, and when it starts and ends: instants, with the IANA
  /// zone its wall times are in (0.4.8; ADR-0007). A trigger (hand-written SQL)
  /// refuses a zone that is not one.
  date         DateTime @db.Date
  startsAt     DateTime? @db.Timestamptz(3) @map("starts_at")
  endsAt       DateTime? @db.Timestamptz(3) @map("ends_at")
  timeZone     String   @map("time_zone")
  location     String?  @db.VarChar(255)

  isCancelled  Boolean  @default(false) @map("is_cancelled")
  cancelNote   String?  @db.VarChar(500) @map("cancel_note")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  training     Training @relation(fields: [trainingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  attendance   Attendance[]

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([id, tenantId])
  /// The parent key of attendance: a session of the same program (0.4.4)
  @@unique([id, tenantId, trainingId])

  @@map("training_sessions")
  @@index([tenantId, date])
  @@index([tenantId, trainingId])
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid @map("tenant_id")
  trainingId      String           @db.Uuid @map("training_id")
  playerId        String           @db.Uuid @map("player_id")

  status          EnrollmentStatus @default(PENDING)
  paymentStatus   PaymentStatus    @default(UNPAID) @map("payment_status")

  rejectionReason String?          @db.VarChar(500) @map("rejection_reason")
  notes           String?          @db.Text

  paidAt          DateTime? @map("paid_at") @db.Timestamptz(3)
  paidAmount      Decimal?         @db.Decimal(19, 4) @map("paid_amount")
  /// The payment's own currency, whatever the programme's (0.4.7). A CHECK
  /// (hand-written SQL) requires it with an amount.
  paidCurrency    String?          @db.Char(3) @map("paid_currency")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  training        Training         @relation(fields: [trainingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  paidCurrencyDefinition CurrencyDefinition? @relation(fields: [paidCurrency], references: [code], onDelete: Restrict, onUpdate: Restrict)
  player          Player           @relation(fields: [playerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  attendance      Attendance[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([trainingId, playerId])
  @@unique([id, tenantId])
  /// The parent key of attendance: an enrollment in the same program (0.4.4)
  @@unique([id, tenantId, trainingId])

  @@map("enrollments")
  @@index([tenantId, playerId])
}

model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid @map("tenant_id")
  enrollmentId      String           @db.Uuid @map("enrollment_id")
  trainingSessionId String           @db.Uuid @map("training_session_id")
  /// The program both parents belong to: each key below includes it, so the
  /// enrollment and the session cannot come from two programs (0.4.4)
  trainingId        String           @db.Uuid @map("training_id")

  /// Denormalized from TrainingSession for query convenience
  date              DateTime @db.Date
  status            AttendanceStatus @default(ABSENT)
  note              String?          @db.VarChar(500)

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  enrollment        Enrollment       @relation(fields: [enrollmentId, tenantId, trainingId], references: [id, tenantId, trainingId], onDelete: Restrict, onUpdate: Restrict)
  trainingSession   TrainingSession  @relation(fields: [trainingSessionId, tenantId, trainingId], references: [id, tenantId, trainingId], onDelete: Restrict, onUpdate: Restrict)

  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([enrollmentId, trainingSessionId])
  @@unique([id, tenantId])

  @@map("attendance")
  @@index([tenantId, date])
  @@index([tenantId, enrollmentId, status])
  @@index([tenantId, trainingSessionId])
}

